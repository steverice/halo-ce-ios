<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The App Sandbox for the native Mac app (port/macos/README.md). Saves, configuration and imported maps live in
     the app's container. Team-signed builds add the iCloud keys from ../ios/VISR-cloud.entitlements. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- the disc image the player picks in the open panel, and the bookmark that reopens it -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- signed data feeds, internet play's brokers, joining system link games -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- hosting system link and internet games -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- SDL's HID controller path for USB and Bluetooth controllers -->
	<key>com.apple.security.device.usb</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
</dict>
</plist>
