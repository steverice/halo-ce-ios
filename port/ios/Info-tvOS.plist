<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>VISR</string>
	<key>CFBundleExecutable</key>
	<string>VISR</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>VISR</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.2</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).join</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>halo</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(HALO_BUILD_NUMBER)</string>
	<key>HaloRenderHeight</key>
	<string>$(HALO_RENDER_HEIGHT)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>VISR uses Bluetooth only to connect game controllers.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>VISR uses your local network to receive your copy of the game from a phone or computer, to find and join system link games on this network, and to host games for nearby players.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_halo-ce._udp</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>SDLSceneConfiguration</string>
					<key>UISceneDelegateClassName</key>
					<string>SDLUIKitSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
</dict>
</plist>
