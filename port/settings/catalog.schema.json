{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VISR hardware capability catalog",
  "description": "Run profile_check.py to check unique identities, tier coverage, references and UTF-8 byte limits.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "version": {
      "type": "string",
      "maxLength": 48,
      "pattern": "\\S"
    },
    "hardware": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "platform": {
            "enum": [
              "ios",
              "tvos",
              "visionos",
              "mac"
            ]
          },
          "models": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9 ,.-]{1,48}$"
            }
          },
          "chips": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9 ,.-]{1,48}$"
            }
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "gpu_family": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "basis": {
            "enum": [
              "measured",
              "assumed",
              "inherited"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "gpu_family",
          "basis",
          "source"
        ],
        "anyOf": [
          {
            "required": [
              "models"
            ],
            "properties": {
              "models": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "chips"
            ],
            "properties": {
              "chips": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    "fallback": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "hardware": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.toml$"
          },
          "minimum_memory_mb": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "minimum_gpu_family": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "maximum_pixels": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            },
            "minItems": 3,
            "maxItems": 3
          },
          "maximum_refresh_hertz": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "additionalProperties": false,
        "required": [
          "hardware",
          "profile",
          "minimum_memory_mb",
          "minimum_gpu_family",
          "maximum_pixels",
          "maximum_refresh_hertz"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "hardware",
    "fallback"
  ]
}
